{
  "manifest_version": 3,
  "name": "TRAZE — Instagram Follower Analytics",
  "version": "1.0.0",
  "description": "Analyze your Instagram data export ZIP offline. Find who doesn't follow back, mutuals, and fans with one-click profile links.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "TRAZE"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
